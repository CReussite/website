# ── Stancer ──────────────────────────────────────────
# manage.stancer.com → Développeurs → Clés API
STANCER_SECRET_KEY=sprod_...
STANCER_PUBLIC_KEY=pprod_...

# ── Supabase ─────────────────────────────────────────
# Supabase → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Brevo ─────────────────────────────────────────────
# brevo.com → Paramètres → Clés API → Générer clé API v3
BREVO_API_KEY=xkeysib-...

# ── Expéditeur ────────────────────────────────────────
FROM_EMAIL=contact@c-reussite.fr
FROM_NAME=C'Réussite

# ── Frontend (redirections Stancer) ───────────────────
FRONTEND_URL=https://c-reussite.fr

# ── Serveur ──────────────────────────────────────────
# Clé d'accès au tableau de bord admin (choisir une valeur aléatoire forte)
ADMIN_KEY=une_cle_secrete_forte
# Email destinataire des alertes ops (erreurs de commandes, etc.)
ALERT_EMAIL=contact@c-reussite.fr
ALERT_FROM_NAME=C'Réussite Monitoring
# Email mis en copie cachée (BCC) de chaque email client
BCC_EMAIL=contact@c-reussite.fr
PORT=3000
