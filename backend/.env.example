# ── Stancer ──────────────────────────────────────────
# manage.stancer.com → Développeurs → Clés API
STANCER_SECRET_KEY=sprod_...
STANCER_PUBLIC_KEY=pprod_...

# ── Supabase ─────────────────────────────────────────
# Supabase → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Brevo ─────────────────────────────────────────────
# brevo.com → Paramètres → Clés API → Générer clé API v3
BREVO_API_KEY=xkeysib-...

# En local, mettre à true pour NE PAS appeler Brevo (les emails sont seulement
# logués). Évite l'alerte de sécurité "nouvelle IP" de Brevo à chaque test depuis
# votre machine. À laisser VIDE/absent en production (Render) pour envoyer pour de vrai.
MAIL_DRY_RUN=false

# ── Expéditeur ────────────────────────────────────────
FROM_EMAIL=contact@c-reussite.fr
FROM_NAME=C'Réussite

# ── Frontend (redirections Stancer) ───────────────────
FRONTEND_URL=https://c-reussite.fr

# ── Serveur ──────────────────────────────────────────
# Mot de passe du tableau de bord admin (1er facteur). Choisir une valeur
# aléatoire forte. L'accès admin est protégé par double authentification :
# ce mot de passe PUIS un code d'application (TOTP) ou un code reçu par email.
ADMIN_KEY=une_cle_secrete_forte
# Email où est envoyé le code de connexion admin de secours (2FA par email).
# À défaut, on retombe sur ALERT_EMAIL puis FROM_EMAIL.
ADMIN_EMAIL=contact@c-reussite.fr
# Email destinataire des alertes ops (erreurs de commandes, etc.)
ALERT_EMAIL=contact@c-reussite.fr
ALERT_FROM_NAME=C'Réussite Monitoring
# Email mis en copie cachée (BCC) de chaque email client
BCC_EMAIL=contact@c-reussite.fr
# Destinataire interne des notifications (avis, retours bêta, extraits en BCC)
NOTIFY_EMAIL=contact@c-reussite.fr
PORT=3000
